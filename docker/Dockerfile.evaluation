# Generic scoring dependencies only; no simulator, environment source or agent CLI.
FROM python:3.11-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir numpy==1.26.4 scipy==1.14.0 gymnasium==1.2.3 \
        imageio==2.37.2 imageio-ffmpeg==0.6.0 pillow==11.3.0
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /tmp
